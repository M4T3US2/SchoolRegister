@model SchoolRegister.ViewModels.VM.AttachDetachSubjectGroupVm

@{
    ViewData["Title"] = "Detach Subject from Group";
}

<div class="container mt-4">
    <div class="card shadow border-danger">
        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">Detach Subject from Group</h3>
        </div>
        <div class="card-body">
            <h4 class="text-secondary">Subject: <strong>@ViewBag.SubjectName</strong></h4>
            <p class="text-muted">Select the group you want to remove this subject from.</p>
            <hr />

            <div class="row">
                <div class="col-md-6">
                    <form asp-action="DetachSubjectFromGroup" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="SubjectId" />

                        <div class="form-group mb-3">
                            <label class="form-label font-weight-bold">Select Group</label>
                            <select asp-for="GroupId" class="form-select form-control" asp-items="@ViewBag.GroupsSelectList">
                                <option value="">-- Choose Group --</option>
                            </select>
                            <span asp-validation-for="GroupId" class="text-danger"></span>
                        </div>

                        <div class="form-group d-flex gap-2">
                            <button type="submit" class="btn btn-danger shadow-sm">
                                <i class="bi bi-trash"></i> Detach from Group
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="card-footer bg-light">
            <small class="text-danger">* Warning: This action will stop students in this group from seeing this subject.</small>
        </div>
    </div>
</div>