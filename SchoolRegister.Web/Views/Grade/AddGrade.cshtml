@using Microsoft.AspNetCore.Mvc.Rendering
@model SchoolRegister.ViewModels.VM.AddGradeToStudentVm

@{
    ViewData["Title"] = "Wystaw ocenę";
}

<div class="container mt-4">
    <h2>Wystaw nową ocenę</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="AddGrade" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group mb-3">
                    <label asp-for="StudentId" class="control-label font-weight-bold">Student</label>
                    <select asp-for="StudentId" class="form-control" 
                            asp-items="@(ViewBag.StudentId as SelectList)">
                        <option value="">-- Wybierz studenta --</option>
                    </select>
                    <span asp-validation-for="StudentId" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="SubjectId" class="control-label font-weight-bold">Przedmiot</label>
                    <select asp-for="SubjectId" class="form-control" 
                            asp-items="@(ViewBag.SubjectId as SelectList)">
                        <option value="">-- Wybierz przedmiot --</option>
                    </select>
                    <span asp-validation-for="SubjectId" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="GradeValue" class="control-label font-weight-bold">Ocena</label>
                    <select asp-for="GradeValue" class="form-control" 
                            asp-items="@(ViewBag.Grades as SelectList)">
                        <option value="">-- Wybierz ocenę --</option>
                    </select>
                    <span asp-validation-for="GradeValue" class="text-danger"></span>
                </div>

                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-plus-circle"></i> Wystaw ocenę
                    </button>
                    <a asp-controller="Subject" asp-action="Index" class="btn btn-secondary">Powrót</a>
                </div>
            </form>
        </div>
    </div>
</div>